---
import Icon from './Icon.astro';
import { site, nav, isActive } from '../site';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-paper-300 bg-paper-100/92 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-[1760px] items-center gap-4 px-5 sm:px-8 lg:px-12">
    {/* Mark only. The name lives on the cover band now, so repeating it in the
        nav was noise. Links off to the side project (chess, running, etc.),
        not home — the nav items below cover home already. */}
    <a href="/creative/" class="flex min-w-0 items-center" aria-label={`${site.name} — Creative`}>
      <span
        class="grid size-7 shrink-0 place-items-center rounded-[7px] border border-paper-400 bg-gradient-to-br from-clay-100 to-paper-200 font-mark text-[16px] text-clay-600 italic"
      >s</span>
    </a>

    <nav class="ml-auto hidden items-center gap-0.5 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(path, item.href) ? 'page' : undefined}
            class:list={[
              'flex items-center gap-1.5 rounded-[5px] px-2.5 py-1.5 text-[13px] transition-colors',
              isActive(path, item.href)
                ? 'bg-paper-200 font-medium text-ink-900'
                : 'text-ink-500 hover:bg-paper-200/70 hover:text-ink-900',
            ]}
          >
            <Icon name={item.icon} size={14} />
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  {/* Mobile nav: same four links, no drawer to hydrate. */}
  <nav
    class="flex items-center gap-1 overflow-x-auto border-t border-paper-300 px-4 py-1.5 md:hidden"
    aria-label="Main (mobile)"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(path, item.href) ? 'page' : undefined}
          class:list={[
            'flex shrink-0 items-center gap-1.5 rounded-[5px] px-2.5 py-1 text-[12.5px]',
            isActive(path, item.href)
              ? 'bg-paper-200 font-medium text-ink-900'
              : 'text-ink-500',
          ]}
        >
          <Icon name={item.icon} size={13} />
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
