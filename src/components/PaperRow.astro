---
import Icon from './Icon.astro';
import { conceptLabel, type Paper } from '../lib/data';

interface Props {
  paper: Paper;
  /** Projects this paper fed into. Surfaced in the info panel. */
  projects?: { slug: string; title: string }[];
  /** Related papers by shared concepts, precomputed by the page. */
  related?: { paper: Paper; shared: string[]; overlap: number }[];
  /** Blog posts written about this paper. Empty until authoring exists. */
  blogs?: { slug: string; title: string }[];
}
const { paper, projects = [], related = [], blogs = [] } = Astro.props;
const { data } = paper;

// Dense list, no cards-with-shadows. This page is a tool. (SPEC §4)
const crumb = [data.theme, data.subtheme].filter(Boolean).join(' / ');
const arxivId = data.url?.match(/(\d{4}\.\d{4,5})/)?.[1] ?? null;

// Everything the slide-in info panel renders, serialised once per row. The
// panel is a single DOM node reused for all 80 rows, so it reads this rather
// than 80 hidden copies of the markup.
const panelPayload = JSON.stringify({
  slug: paper.slug,
  title: data.title,
  status: data.status,
  crumb,
  url: data.url,
  arxivId,
  tags: data.tags,
  concepts: paper.concepts.map((c) => ({ id: c, label: conceptLabel(c) })),
  related: related.map((r) => ({
    slug: r.paper.slug,
    title: r.paper.data.title,
    shared: r.shared.map(conceptLabel),
    overlap: r.overlap,
  })),
  projects,
  blogs,
});
---

<article
  class:list={[
    'prow group rounded-[6px] border border-paper-300 px-3 py-3 transition-colors',
    `prow-${data.status}`,
  ]}
  data-theme={data.theme}
  data-status={data.status}
  data-title={data.title.toLowerCase()}
  data-tags={data.tags.join(' ').toLowerCase()}
  data-concepts={paper.concepts.join(' ')}
  data-slug={paper.slug}
  data-panel={panelPayload}
>
  <div class="flex items-start gap-3">
    <div class="min-w-0 flex-1">
      <h3 class="text-[14.5px] leading-snug font-medium text-ink-900 group-hover:text-clay-600">
        {data.title}
      </h3>

      <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11.5px] text-ink-400">
        <span class="inline-flex items-center gap-1">
          <Icon name="theme" size={11} />{crumb}
        </span>
      </p>

    </div>

    <div class="flex shrink-0 flex-wrap items-center justify-end gap-1.5">
      {
        data.url && (
          <a href={data.url} target="_blank" rel="noopener" class="chip">
            <Icon name="external" size={11} />
            {arxivId ? `arXiv:${arxivId}` : 'link'}
          </a>
        )
      }
      <span
        class="chip tabular"
        title={`${paper.concepts.length} concept${paper.concepts.length === 1 ? '' : 's'}`}
      >
        <Icon name="concept" size={11} />{paper.concepts.length}
      </span>
    </div>
  </div>
</article>
